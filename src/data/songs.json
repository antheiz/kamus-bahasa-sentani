{
  "songs": [
    {
      "id": 1,
      "title": "Anna",
      "composer": "Frietz Mansawan",
      "description": "Lagu rohani yang menggambarkan keindahan dan harapan dalam Yerusalem",
      "lyrics": [
        {
          "type": "verse",
          "content": [
            "Anna Rare Honggarea",
            "Anna rare Holewarea",
            "Romiyeare isebhonde",
            "rare....Mokhowarea",
            "Anna Wa Foi Khabangsele"
          ]
        },
        {
          "type": "verse",
          "content": [
            "Iyjea phuheseyea khowarea",
            "na foi-moi helle Mhokhowarea",
            "khena phuhea hewarea",
            "rabho halewoyea",
            "Romiyeare ereyembondere"
          ]
        },
        {
          "type": "chorus",
          "content": [
            "Phurayaufa oroyeyea",
            "wa menemo ikheayarea",
            "wa phuhea khokhounge aibhoyarea",
            "anna oh anna"
          ]
        },
        {
          "type": "verse",
          "content": [
            "Nahele khoro nakhe miyea",
            "na foi-moi mokhoyaime",
            "nekhmayende pekho eimokohoijea"
          ]
        }
      ]
    },
    {
      "id": 2,
      "title": "Foi Moi Sele",
      "composer": "Pieter Pallo",
      "description": "Lagu rohani yang memuji kebesaran Yesus dan cinta-Nya kepada umat manusia",
      "lyrics": [
        {
          "type": "verse",
          "content": [
            "Foi moi sele Tuhan ware wayete",
            "Onomi fokha mei waline yeyama",
            "Nebeinye Tuhan Mea",
            "Ware bhuma kholayete",
            "Mei Wali einye Tuhan Nekhewende"
          ]
        },
        {
          "type": "verse",
          "content": [
            "Mei Khena u wei einyemo nekhemande",
            "Mei Hole einye khukuimeme nekhemande",
            "Bulo fela hugalo uhele nekhemande",
            "Mei wali einye Tuhan Nekhewende"
          ]
        },
        {
          "type": "chorus",
          "content": [
            "Tuhan ei rime a waremo",
            "Tuhan wembaisele mei rabo",
            "Wei einyemo meya nekhemande",
            "benenfonde mele"
          ]
        }
      ]
    }
  ]
}